{
  "name": "coll-plan3d",
  "productName": "Coll Plan3D",
  "version": "1.5.12",
  "description": "Turn AutoCAD (DXF/DWG) floor plans or plan photos into 3D walkthroughs. Coll Business Solutions LLC.",
  "author": "Coll Business Solutions LLC",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "cfb": "1.2.2",
    "dxf-parser": "1.1.2",
    "electron-updater": "6.3.9",
    "three": "0.128.0",
    "web-ifc": "0.0.77"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.collbusinesssolutions.plan3d",
    "productName": "Coll Plan3D",
    "copyright": "Coll Business Solutions LLC",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "samples/**",
      "README.txt",
      "dxf2000.js"
    ],
    "asar": false,
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Coll Plan3D",
      "artifactName": "Coll-Plan3D-Setup.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "plan3d",
        "name": "Coll Plan3D project",
        "description": "Coll Plan3D project",
        "icon": "build/icon.ico"
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/jeremymcollins89-prog/coll-landing-page/releases/download/plan3d/"
      }
    ],
    "extraResources": [
      {
        "from": "libredwg",
        "to": "libredwg",
        "filter": [
          "*.exe",
          "*.dll",
          "*.txt",
          "*.dxf"
        ]
      }
    ],
    "appx": {
      "applicationId": "CollPlan3D",
      "displayName": "Coll Plan3D",
      "publisherDisplayName": "Coll Business Solutions LLC",
      "backgroundColor": "#121719",
      "languages": [
        "en-US"
      ],
      "artifactName": "Coll-Plan3D-${version}.${ext}"
    }
  }
}
