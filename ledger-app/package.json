{
  "name": "coll-ledger",
  "productName": "Coll Ledger",
  "version": "1.10.0",
  "description": "Premium bookkeeping for independent bookkeepers. Coll Business Solutions LLC.",
  "author": "Coll Business Solutions LLC <collbusinesssolutions@gmail.com>",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "preview": "node scripts/bundle-preview.js",
    "test": "node scripts/test-core.js && node scripts/test-academy.js && node scripts/test-cases.js"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "electron-updater": "6.8.10",
    "pdfjs-dist": "6.4.299",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "electron": "44.7.1",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.collbusinesssolutions.ledger",
    "productName": "Coll Ledger",
    "copyright": "Coll Business Solutions LLC",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/tesseract.js-core/*.wasm.js",
      "!node_modules/@tesseract.js-data/eng/4.0.0/**",
      "!node_modules/pdfjs-dist/web/**",
      "!node_modules/pdfjs-dist/build/**",
      "!node_modules/pdfjs-dist/image_decoders/**",
      "!node_modules/pdfjs-dist/types/**",
      "!node_modules/pdfjs-dist/**/*.map",
      "!node_modules/@napi-rs/**",
      "!node_modules/**/*.md",
      "!node_modules/**/*.d.ts"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Coll Ledger",
      "artifactName": "Coll-Ledger-Setup.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.finance",
      "icon": "build/icon.png",
      "artifactName": "Coll-Ledger.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/jeremymcollins89-prog/coll-landing-page/releases/download/coll-ledger/"
      }
    ],
    "asar": false
  }
}
